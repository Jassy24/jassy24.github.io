{{ define "main" }}
<div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
  <!-- LEFT SIDE: TEXT -->
  <div>
    <h1 class="text-4xl font-bold mb-2">{{ .Title }}</h1>
    <p class="text-sm text-gray-400 mb-4">{{ .Date.Format "January 2, 2006" }}</p>

    {{ with .Params.tags }}
    <div class="mb-6">
      {{ range . }}
        <span class="inline-block bg-purple-800 text-white text-xs font-semibold mr-2 px-3 py-1 rounded-full uppercase">{{ . }}</span>
      {{ end }}
    </div>
    {{ end }}

    <div class="prose prose-invert prose-lg max-w-none">
      {{ .Content }}
    </div>
  </div>

  <!-- RIGHT SIDE: IMAGE + CTA -->
  {{ with .Params.image }}
  <div class="flex flex-col items-center justify-start gap-6">
    <img src="{{ . }}" alt="{{ $.Title }}" class="rounded-md shadow-xl w-full object-cover" />
    <a href="/blog" class="bg-purple-600 hover:bg-purple-700 transition text-white font-medium px-5 py-2 rounded-md">← Back to Blog</a>
  </div>
  {{ end }}
</div>
{{ end }}
