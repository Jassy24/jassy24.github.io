{{ define "main" }}
<div class="mx-auto max-w-6xl px-4 py-10">
  <h1 class="text-4xl font-bold text-white mb-10 text-center">Blog</h1>
  
  <div class="flex flex-col space-y-12">
    {{ range .Pages.ByDate.Reverse }}
    <div class="flex flex-col lg:flex-row gap-8 items-start bg-[#1e1e2f] p-6 rounded-lg shadow-lg">
      
      <!-- Left Side: Title + Excerpt -->
      <div class="lg:w-2/3">
        <h2 class="text-2xl font-semibold text-white">{{ .Title }}</h2>
        <p class="text-sm text-gray-400 mt-1">{{ .Date.Format "Jan 2, 2006" }}</p>
        <p class="text-md text-gray-300 mt-4">{{ .Params.description }}</p>
        <a href="{{ .RelPermalink }}" class="inline-block mt-6 px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-500 transition">
          Read More
        </a>
      </div>

      <!-- Right Side: Image -->
      <div class="lg:w-1/3">
        {{ with .Params.image }}
        <img src="{{ . }}" alt="{{ $.Title }}" class="rounded-md shadow-md object-cover w-full max-h-60" />
        {{ end }}
      </div>
    </div>
    {{ end }}
  </div>
</div>
{{ end }}
